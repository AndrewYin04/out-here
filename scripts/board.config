# Overnight board config (sourced by scripts/board.sh). No secrets here — safe to commit.

# GitHub repo that holds the board issue.
REPO=AndrewYin04/out-here

# Board issue number. Filled in by: scripts/board.sh init
ISSUE=

# Comma-separated GitHub logins of the 5 teammates. ONLY comments from these
# logins are treated as instructions. The agent refuses to read the board while empty.
TEAM_LOGINS=

# GitHub login to @mention on question / blocked / alert posts (they get a phone push).
ONCALL=
