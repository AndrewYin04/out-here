# Copy to .env.local and fill in. Names only here; never commit .env.local.
# Scripts load it with `node --env-file=.env.local`. Values are in docs/muse-api.md and plan section 5a.

# Muse (see docs/muse-api.md)
MUSE_API_KEY=
MUSE_BASE_URL=
MUSE_MODEL_FAST=
MUSE_MODEL_SMART=
MUSE_MODEL_VISION=
MUSE_MODEL_IMAGE=
# 1 = force mock responses (builders and offline dev; the demo must run on real Muse)
MUSE_MOCK=

# Which Supabase project the app and scripts use: dev or demo (Vercel sets demo)
DATA_TARGET=

# Supabase demo project (out-here-demo). Keys are the new sb_publishable_ / sb_secret_ keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string, port 5432 (migrations and seed only)
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# Supabase dev project (out-here-dev): every test, verifier run, and builder experiment
NEXT_PUBLIC_SUPABASE_URL_DEV=
NEXT_PUBLIC_SUPABASE_ANON_KEY_DEV=
SUPABASE_SERVICE_ROLE_KEY_DEV=
SUPABASE_DB_URL_DEV=
SUPABASE_DB_PASSWORD_DEV=

# Vercel: written by `vercel link`
VERCEL_OIDC_TOKEN=
